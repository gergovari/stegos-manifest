{
	"version": "0.1",
	"description": "stegOS Environment Initialization Manifest",
	"sources": {
		"bitbake": {
			"git-remote": {
				"remotes": { "origin": { "uri": "https://git.openembedded.org/bitbake" } },
				"rev": "master"
			},
			"path": "bitbake"
		},
		"openembedded-core": {
			"git-remote": {
				"remotes": { "origin": { "uri": "https://git.openembedded.org/openembedded-core" } },
				"rev": "wrynose"
			},
			"path": "openembedded-core"
		},
		"meta-openembedded": {
			"git-remote": {
				"remotes": { "origin": { "uri": "https://git.openembedded.org/meta-openembedded" } },
				"rev": "wrynose"
			},
			"path": "meta-openembedded"
		},
		"meta-virtualization": {
			"git-remote": {
				"remotes": { "origin": { "uri": "https://git.yoctoproject.org/meta-virtualization" } },
				"rev": "wrynose"
			},
			"path": "meta-virtualization"
		},
		"meta-selinux": {
			"git-remote": {
				"remotes": {
					"origin": {
						"uri": "https://git.yoctoproject.org/git/meta-selinux"
					}
				},
				"rev": "wrynose"
			},
			"path": "meta-selinux"
		},
		"stegos": {
			"git-remote": {
				"remotes": { "origin": { "uri": "https://github.com/gergovari/stegos.git" } },
				"rev": "wrynose"
			},
			"path": "stegos"
		}
	},
	"bitbake-setup": {
		"configurations": [
			{
				"name": "stegos",
				"description": "The default stegOS build environment.",
				"bb-layers": [
					"openembedded-core/meta",
					"meta-openembedded/meta-oe",
					"meta-openembedded/meta-python",
					"meta-openembedded/meta-networking",
					"meta-openembedded/meta-filesystems",
					"meta-virtualization",
					"meta-selinux",
					"stegos/meta-stegos"
				],
				"setup-dir-name": "stegos-build"
			}
		]
	}
}
