#!/bin/bash
# Source this file to activate the stegOS environment

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: . stegos-env"
    echo ""
    echo "Activates the stegOS developer environment by sourcing the BitBake"
    echo "initialization script and adding the workflow scripts to your PATH."
    echo ""
    echo "Note: This script MUST be sourced, not executed."
    return 0 2>/dev/null || exit 0
fi

if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
    echo "Error: This script must be sourced! Run: . stegos-env"
    exit 1
fi

WORKSPACE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export PATH="$WORKSPACE/stegos-manifest/scripts:$PATH"

VENV_DIR="$WORKSPACE/stegos-manifest/.venv"
if [ ! -d "$VENV_DIR" ]; then
    echo "=> Creating Python virtual environment..."
    python3 -m venv "$VENV_DIR"
fi
echo "=> Activating Python virtual environment..."
source "$VENV_DIR/bin/activate"

if [ -f "$WORKSPACE/stegos-manifest/requirements.txt" ]; then
    pip install --quiet -r "$WORKSPACE/stegos-manifest/requirements.txt"
fi
if [ -f "$WORKSPACE/stegos-utils/requirements-test.txt" ]; then
    pip install --quiet -r "$WORKSPACE/stegos-utils/requirements-test.txt"
fi


if [ -f "$WORKSPACE/bitbake-builds/stegos-setup-stegos/build/init-build-env" ]; then
    echo "=> Sourcing BitBake environment..."
    cd "$WORKSPACE/bitbake-builds/stegos-setup-stegos" || return 1
    . build/init-build-env
else
    echo "Error: Build environment not found."
    echo "Have you run bitbake-setup?"
fi

if [ -f "$WORKSPACE/stegos-manifest/scripts/stegos-completion.bash" ]; then
    source "$WORKSPACE/stegos-manifest/scripts/stegos-completion.bash"
fi
