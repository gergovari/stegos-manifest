#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
import shutil

def main():
    parser = argparse.ArgumentParser(description="Runs the stegOS Live CD in QEMU.")
    parser.add_argument("-g", "--gui", action="store_true", help="Launch QEMU with a graphical window (defaults to nographic)")
    parser.add_argument("-d", "--drive", action="append", help="Mount a virtual drive as a virtio block device (can be used multiple times)")
    
    args = parser.parse_args()
    
    if not shutil.which("runqemu"):
        print("Error: runqemu command not found in your PATH.")
        print("Did you source the environment? Run: . stegos-env")
        sys.exit(1)
        
    cmd_args = ["runqemu", "iso", "slirp", "kvm"]
    
    # Silence Yocto ISO boot warnings
    cmd_args.append("bootparams=quiet loglevel=3")
    
    if not args.gui:
        cmd_args.append("nographic")
        print("=> Running stegos-livecd in QEMU... (Tip: Press Ctrl-A then X to exit nographic mode)")
    else:
        print("=> Running stegos-livecd in QEMU... (GUI mode)")
        
    qemu_params = ["-m 2048"]
    
    if args.drive:
        for img in args.drive:
            qemu_params.append(f"-drive file={img},format=raw,if=virtio")
            
    if qemu_params:
        full_params = " ".join(qemu_params)
        print(f"   (QEMU Params: {full_params})")
        cmd_args.append(f"qemuparams={full_params}")
        
    try:
        subprocess.run(cmd_args, check=True)
    except subprocess.CalledProcessError as e:
        print(f"\nError: runqemu exited with code {e.returncode}")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nQEMU stopped by user.")
        sys.exit(0)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
