#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
import shutil

def print_header(msg):
    print(f"\n==================================================")
    print(f"=> {msg}")
    print(f"==================================================")

def sync_repo(workspace, repo_dir, message):
    repo_path = os.path.join(workspace, repo_dir)
    git_dir = os.path.join(repo_path, ".git")
    
    if not os.path.isdir(git_dir):
        print(f"=> No local repo found at {repo_path}")
        return

    # Check for changes
    status_proc = subprocess.run(["git", "status", "--porcelain"], cwd=repo_path, capture_output=True, text=True)
    if status_proc.returncode != 0:
        print(f"Error checking git status in {repo_dir}")
        return
        
    output = status_proc.stdout.strip()
    if output:
        print_header(f"Changes detected in: {repo_dir}")
        subprocess.run(["git", "status", "-s"], cwd=repo_path)
        print("")
        
        commit_msg = message
        if not commit_msg:
            try:
                commit_msg = input(f"Enter commit message for {repo_dir} (leave blank to skip): ").strip()
            except KeyboardInterrupt:
                print("\nSync aborted.")
                sys.exit(1)
            except EOFError:
                print("\nSync aborted.")
                sys.exit(1)
                
        if commit_msg:
            subprocess.run(["git", "add", "-A"], cwd=repo_path, check=True)
            subprocess.run(["git", "commit", "-m", commit_msg], cwd=repo_path, check=True)
            print(f"=> Pushing {repo_dir} to remote...")
            subprocess.run(["git", "push"], cwd=repo_path, check=True)
        else:
            print(f"=> No commit message provided. Skipping commit for {repo_dir}.")
            
    # Pull remote changes regardless
    subprocess.run(["git", "pull", "--rebase"], cwd=repo_path, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    
    # Copy workspace repo contents into the Yocto build layers directory.
    # This ensures local edits are immediately available to bitbake without
    # needing a full bitbake-setup update or git commit.
    layer_dir = os.path.join(workspace, "bitbake-builds", "stegos-setup-stegos", "layers", repo_dir)
    if os.path.isdir(layer_dir):
        print(f"=> Syncing {repo_dir} into Yocto build environment...")
        try:
            subprocess.run(
                ["rsync", "-a", "--delete", "--exclude", ".git",
                 repo_path + "/", layer_dir + "/"],
                check=True
            )
        except FileNotFoundError:
            # rsync not available, fall back to manual copy
            # Remove old contents (except .git) and copy fresh
            for item in os.listdir(layer_dir):
                if item == ".git":
                    continue
                path = os.path.join(layer_dir, item)
                if os.path.isdir(path):
                    shutil.rmtree(path)
                else:
                    os.remove(path)
            for item in os.listdir(repo_path):
                if item == ".git":
                    continue
                src = os.path.join(repo_path, item)
                dst = os.path.join(layer_dir, item)
                if os.path.isdir(src):
                    shutil.copytree(src, dst)
                else:
                    shutil.copy2(src, dst)
            print(f"   (used file copy fallback — rsync not available)")

def main():
    parser = argparse.ArgumentParser(description="Synchronizes local stegOS repositories and updates the bitbake setup.")
    parser.add_argument("--message", "-m", help="Commit message to use for all repos with changes (bypasses interactive prompt)")
    parser.add_argument("--repo", "-r", help="Specific repository to sync (e.g., 'stegos' or 'stegos-utils'). Defaults to all.")
    parser.add_argument("--update-yocto", action="store_true", help="Update yocto layers via bitbake-setup (defaults to off)")
    
    args = parser.parse_args()
    
    # Locate workspace relative to this script
    script_dir = os.path.dirname(os.path.abspath(__file__))
    workspace = os.path.abspath(os.path.join(script_dir, "../.."))
    
    if args.repo:
        repos_to_sync = [args.repo]
        if not os.path.isdir(os.path.join(workspace, args.repo, ".git")):
            print(f"Warning: '{args.repo}' does not appear to be a valid git repository, but will try syncing it anyway.")
    else:
        repos_to_sync = []
        for entry in sorted(os.listdir(workspace)):
            if os.path.isdir(os.path.join(workspace, entry, ".git")):
                repos_to_sync.append(entry)
        
    for repo in repos_to_sync:
        sync_repo(workspace, repo, args.message)
        
    if args.update_yocto:
        print_header("Running bitbake-setup update...")
        try:
            subprocess.run(["bitbake-setup", "update", "--setup-dir", "./bitbake-builds/stegos-setup-stegos", "--update-bb-conf", "no"], cwd=workspace, check=True)
        except FileNotFoundError:
            print("Error: bitbake-setup command not found. Ensure it is installed on your host system.")
            sys.exit(1)
        except subprocess.CalledProcessError:
            print("Error: bitbake-setup update failed.")
            sys.exit(1)
    else:
        print("\n=> Skipping bitbake-setup update. Use --update-yocto to include it.")

    # Clean the image recipe so bitbake picks up layer changes on the next build.
    # This only removes the image recipe's work directory — all compiled packages
    # stay in sstate, so the rebuild is fast (rootfs + ISO regeneration only).
    if shutil.which("bitbake"):
        print_header("Cleaning image cache...")
        subprocess.run(
            ["bitbake", "stegos-livecd", "-c", "clean"],
            cwd=workspace, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        
    print("\n=> Sync complete.")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
