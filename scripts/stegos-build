#!/bin/bash
# Builds the StegOS Live CD

# Ensure we are in a bitbake environment
if ! command -v bitbake &> /dev/null; then
    echo "Error: bitbake command not found."
    echo "Did you source the environment? Run: . stegos-env"
    exit 1
fi

echo "=> Building stegos-livecd..."
bitbake stegos-livecd
